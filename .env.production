# Production build: legacy PHP API is served under the /unigrant_rest prefix on the same host.
# Vite loads this automatically for `vite build`; `npm run dev` keeps .env (/api + local proxy).
VITE_API_BASE=/unigrant_rest

# Origin of the Node content backend. The app appends `/api`, so this is the host only —
# requests resolve to https://innohub.unisza.edu.my/api/... (uploads at /uploads/...).
VITE_CONTENT_API_ORIGIN=https://innohub.unisza.edu.my
